#if defined _tarkenso_tds_export
    #endinput
#endif
#define _tarkenso_tds_export

// open.mp file natives are confined to scriptfiles. This is a trusted build setting.
#if !defined TDS_EXPORT_DIR
    #define TDS_EXPORT_DIR "tdstudio_exports"
#endif
new File:gTDSExportFile[TDS_SESSIONS];
new gTDSExportPrefix[TDS_SESSIONS][24];
new gTDSExportPath[TDS_SESSIONS][128];
new gTDSExportSlots[TDS_SESSIONS][TDS_ELEMENTS];
new gTDSExportCount[TDS_SESSIONS], gTDSExportAt[TDS_SESSIONS], gTDSExportSerial;

stock bool:TDS_PawnEscape(const source[], dest[], capacity)
{
    new at;
    for (new i; source[i]; i++)
    {
        new c = source[i];
        if (at+3 >= capacity) return false;
        if (c == '\\' || c == '"') dest[at++] = '\\';
        if (c == '\n' || c == '\r' || c == '\t')
        {
            dest[at++] = '\\';
            c = c == '\n' ? 'n' : (c == '\r' ? 'r' : 't');
        }
        else if (c < 32 || c > 255) return false;
        dest[at++] = c;
    }
    dest[at] = EOS;
    return true;
}

stock bool:TDSExp_Write(File:file, const text[])
{
    if (!file) return false;
    for (new i; text[i]; i++) if (!fputchar(file,text[i],false)) return false;
    return true;
}

stock TDSExp_Cancel(session)
{
    if (!gTDSExportFile[session]) return 1;
    fclose(gTDSExportFile[session]); gTDSExportFile[session] = File:0;
    if (fexist(gTDSExportPath[session])) fremove(gTDSExportPath[session]);
    if (gTDS[session][tsBusy] == -1) gTDS[session][tsBusy] = 0;
    return 1;
}

stock bool:TDSExp_Header(session)
{
    new line[512], count = gTDSExportCount[session], bool:personal = gTDS[session][tsInterface] == 1;
    new prefix[24]; format(prefix,sizeof(prefix),"%s",gTDSExportPrefix[session]);
    format(line,sizeof(line),"// Generated by TARKENSO TextDraw Studio. Encoding: CP1251.\n// Include after <open.mp>. Lifecycle instructions are in the companion .txt.\n#if defined _%s_inc\n    #endinput\n#endif\n#define _%s_inc\n",prefix,prefix);
    if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
    if (personal)
        format(line,sizeof(line),"static PlayerText:%s_td[MAX_PLAYERS][%d];\nstatic bool:%s_live[MAX_PLAYERS];\n\nstock %s_Create(playerid)\n{\n    if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid)) return 0;\n    if (%s_live[playerid]) return 1;\n",prefix,count ? count : 1,prefix,prefix,prefix);
    else format(line,sizeof(line),"static Text:%s_td[%d];\nstatic bool:%s_live;\n\nstock %s_Create()\n{\n    if (%s_live) return 1;\n",prefix,count ? count : 1,prefix,prefix,prefix);
    if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
    if (!count)
    {
        format(line,sizeof(line),"    #pragma unused %s_td\n",prefix);
        if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
    }
    if (count)
    {
        if (personal) format(line,sizeof(line),"    for (new i; i < %d; i++) %s_td[playerid][i] = INVALID_PLAYER_TEXT_DRAW;\n",count,prefix);
        else format(line,sizeof(line),"    for (new i; i < %d; i++) %s_td[i] = INVALID_TEXT_DRAW;\n",count,prefix);
        if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
    }
    if (personal) format(line,sizeof(line),"    %s_live[playerid] = true;\n",prefix);
    else format(line,sizeof(line),"    %s_live = true;\n",prefix);
    return TDSExp_Write(gTDSExportFile[session],line);
}

stock bool:TDSExp_Call(session, index, const function[], const args[])
{
    new line[768];
    if (gTDS[session][tsInterface]) format(line,sizeof(line),"    PlayerTextDraw%s(playerid, %s_td[playerid][%d], %s);\n",function,gTDSExportPrefix[session],index,args);
    else format(line,sizeof(line),"    TextDraw%s(%s_td[%d], %s);\n",function,gTDSExportPrefix[session],index,args);
    return TDSExp_Write(gTDSExportFile[session],line);
}

stock bool:TDSExp_Element(session, index)
{
    new slot = gTDSExportSlots[session][index], line[768], content[TDS_TEXT*2+8], raw[TDS_TEXT];
    new data[E_TDS_ELEMENT];
    for (new E_TDS_ELEMENT:f; f < E_TDS_ELEMENT; f++) data[f] = gTDSElement[session][slot][f];
    switch (data[tdType])
    {
        case TDS_TEXT_TYPE: format(raw,sizeof(raw),"%s",data[tdText]);
        case TDS_RECT_TYPE: format(raw,sizeof(raw),"LD_SPAC:white");
        case TDS_SPRITE_TYPE: format(raw,sizeof(raw),"%s",gTDSSprites[data[tdSprite]]);
        case TDS_MODEL_TYPE: format(raw,sizeof(raw),"_");
    }
    if (!TDS_PawnEscape(raw,content,sizeof(content))) return false;
    if (gTDS[session][tsInterface])
        format(line,sizeof(line),"    // Element ID %d, order %d\n    %s_td[playerid][%d] = CreatePlayerTextDraw(playerid, %.9f, %.9f, \"%%s\", \"%s\");\n    if (%s_td[playerid][%d] == INVALID_PLAYER_TEXT_DRAW) { %s_Destroy(playerid); return 0; }\n",
            data[tdId],data[tdOrder],gTDSExportPrefix[session],index,data[tdX],data[tdY],content,gTDSExportPrefix[session],index,gTDSExportPrefix[session]);
    else format(line,sizeof(line),"    // Element ID %d, order %d\n    %s_td[%d] = TextDrawCreate(%.9f, %.9f, \"%%s\", \"%s\");\n    if (%s_td[%d] == INVALID_TEXT_DRAW) { %s_Destroy(); return 0; }\n",
            data[tdId],data[tdOrder],gTDSExportPrefix[session],index,data[tdX],data[tdY],content,gTDSExportPrefix[session],index,gTDSExportPrefix[session]);
    if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
    new font = data[tdFont];
    if (data[tdType] == TDS_MODEL_TYPE) font = 5;
    else if (data[tdType] != TDS_TEXT_TYPE) font = 4;
    format(line,sizeof(line),"TEXT_DRAW_FONT:%d",font);
    if (!TDSExp_Call(session,index,"Font",line)) return false;
    format(line,sizeof(line),"0x%08x",data[tdColour]);
    if (!TDSExp_Call(session,index,"Colour",line)) return false;
    new Float:w = data[tdW], Float:h = data[tdH];
    if (data[tdType] == TDS_TEXT_TYPE)
    {
        if (data[tdAlign] == 1) w += data[tdX];
        else if (data[tdAlign] == 3) w = data[tdX]-w;
        else { w = data[tdH]; h = data[tdW]; }
        format(line,sizeof(line),"TEXT_DRAW_ALIGN:%d",data[tdAlign]);
        if (!TDSExp_Call(session,index,"Alignment",line)) return false;
        format(line,sizeof(line),"%.9f, %.9f",data[tdLetterX],data[tdLetterY]);
        if (!TDSExp_Call(session,index,"LetterSize",line)) return false;
        if (!TDSExp_Call(session,index,"UseBox",data[tdBox] ? ("true") : ("false"))) return false;
        format(line,sizeof(line),"0x%08x",data[tdBoxColour]);
        if (!TDSExp_Call(session,index,"BoxColour",line)) return false;
        format(line,sizeof(line),"%d",data[tdOutline]);
        if (!TDSExp_Call(session,index,"SetOutline",line)) return false;
        format(line,sizeof(line),"%d",data[tdShadow]);
        if (!TDSExp_Call(session,index,"SetShadow",line)) return false;
        if (!TDSExp_Call(session,index,"SetProportional",data[tdProportional] ? ("true") : ("false"))) return false;
    }
    format(line,sizeof(line),"%.9f, %.9f",w,h);
    if (!TDSExp_Call(session,index,"TextSize",line)) return false;
    if (!TDSExp_Call(session,index,"SetSelectable",data[tdSelectable] ? ("true") : ("false"))) return false;
    if (data[tdType] == TDS_TEXT_TYPE || data[tdType] == TDS_MODEL_TYPE)
    {
        format(line,sizeof(line),"0x%08x",data[tdBackground]);
        if (!TDSExp_Call(session,index,"BackgroundColour",line)) return false;
    }
    if (data[tdType] == TDS_MODEL_TYPE)
    {
        format(line,sizeof(line),"%d",data[tdModel]);
        if (!TDSExp_Call(session,index,"SetPreviewModel",line)) return false;
        format(line,sizeof(line),"%.9f, %.9f, %.9f, %.9f",data[tdRotX],data[tdRotY],data[tdRotZ],data[tdZoom]);
        if (!TDSExp_Call(session,index,"SetPreviewRot",line)) return false;
        if (data[tdModel] >= 400 && data[tdModel] <= 611)
        {
            format(line,sizeof(line),"%d, %d",data[tdVehColour1],data[tdVehColour2]);
            if (!TDSExp_Call(session,index,"SetPreviewVehicleColours",line)) return false;
        }
    }
    return true;
}

stock bool:TDSExp_Footer(session)
{
    new line[768], prefix[24], count = gTDSExportCount[session], bool:personal = gTDS[session][tsInterface] == 1;
    format(prefix,sizeof(prefix),"%s",gTDSExportPrefix[session]);
    if (!TDSExp_Write(gTDSExportFile[session],"    return 1;\n}\n")) return false;
    for (new hidden; hidden < 2; hidden++)
    {
        format(line,sizeof(line),"\nstock %s_%s(playerid)\n{\n    if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid)) return 0;\n",prefix,hidden ? ("Hide") : ("Show"));
        if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
        if (personal) format(line,sizeof(line),"    if (!%s_live[playerid]) return 0;\n",prefix);
        else format(line,sizeof(line),"    if (!%s_live) return 0;\n",prefix);
        if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
        for (new i; i < count; i++)
        {
            if (personal) format(line,sizeof(line),"    PlayerTextDraw%s(playerid, %s_td[playerid][%d]);\n",hidden ? ("Hide") : ("Show"),prefix,i);
            else format(line,sizeof(line),"    TextDraw%sForPlayer(playerid, %s_td[%d]);\n",hidden ? ("Hide") : ("Show"),prefix,i);
            if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
        }
        if (!TDSExp_Write(gTDSExportFile[session],"    return 1;\n}\n")) return false;
    }
    if (personal) format(line,sizeof(line),"\nstock %s_Destroy(playerid)\n{\n    if (playerid < 0 || playerid >= MAX_PLAYERS) return 0;\n    if (!%s_live[playerid]) return 1;\n    %s_live[playerid] = false;\n",prefix,prefix,prefix);
    else format(line,sizeof(line),"\nstock %s_Destroy()\n{\n    if (!%s_live) return 1;\n    %s_live = false;\n",prefix,prefix,prefix);
    if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
    for (new i; i < count; i++)
    {
        if (personal) format(line,sizeof(line),"    if (IsValidPlayerTextDraw(playerid, %s_td[playerid][%d])) PlayerTextDrawDestroy(playerid, %s_td[playerid][%d]);\n    %s_td[playerid][%d] = INVALID_PLAYER_TEXT_DRAW;\n",prefix,i,prefix,i,prefix,i);
        else format(line,sizeof(line),"    if (IsValidTextDraw(%s_td[%d])) TextDrawDestroy(%s_td[%d]);\n    %s_td[%d] = INVALID_TEXT_DRAW;\n",prefix,i,prefix,i,prefix,i);
        if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
    }
    if (!TDSExp_Write(gTDSExportFile[session],"    return 1;\n}\n")) return false;
    if (personal) format(line,sizeof(line),"\nstock %s_Hit(playerid, PlayerText:clicked)\n{\n    if (playerid < 0 || playerid >= MAX_PLAYERS || !%s_live[playerid]) return -1;\n",prefix,prefix);
    else format(line,sizeof(line),"\nstock %s_Hit(Text:clicked)\n{\n    if (!%s_live) return -1;\n",prefix,prefix);
    if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
    if (!count && !TDSExp_Write(gTDSExportFile[session],"    #pragma unused clicked\n")) return false;
    for (new i; i < count; i++)
    {
        new slot = gTDSExportSlots[session][i];
        if (personal) format(line,sizeof(line),"    if (clicked == %s_td[playerid][%d]) return %d;\n",prefix,i,gTDSElement[session][slot][tdId]);
        else format(line,sizeof(line),"    if (clicked == %s_td[%d]) return %d;\n",prefix,i,gTDSElement[session][slot][tdId]);
        if (!TDSExp_Write(gTDSExportFile[session],line)) return false;
    }
    return TDSExp_Write(gTDSExportFile[session],"    return -1;\n}\n");
}

stock bool:TDSExp_Instructions(session, const path[])
{
    new File:file = fopen(path,io_write);
    if (!file) return false;
    new line[1024], prefix[24]; format(prefix,sizeof(prefix),"%s",gTDSExportPrefix[session]);
    new bool:ok = TDSExp_Write(file,"ENCODING: CP1251 (raw bytes), matching TARKENSO build staging.\nCopy the .inc from scriptfiles/tdstudio_exports into gamemodes/includes.\nInclude it after <open.mp>. When committing to this UTF-8 repository, decode\nCP1251 to UTF-8 first; the normal build converts UTF-8 back to CP1251.\nKeep the existing server rustext component; no client mods are required.\n");
    if (gTDS[session][tsInterface]) format(line,sizeof(line),
        "PlayerTextDraw lifecycle:\nOnPlayerSpawn (or UI entry): %s_Create(playerid); %s_Show(playerid);\nOnPlayerDisconnect: %s_Destroy(playerid);\nOnGameModeExit: loop connected players and call %s_Destroy(playerid).\nHide without destroying: %s_Hide(playerid).\nRoute clicks from OnPlayerClickPlayerTextDraw through %s_Hit(playerid, playertextid).\n",prefix,prefix,prefix,prefix,prefix,prefix);
    else format(line,sizeof(line),
        "Global TextDraw lifecycle:\nOnGameModeInit: %s_Create();\nUI entry: %s_Show(playerid);\nUI exit: %s_Hide(playerid);\nOnGameModeExit: %s_Destroy();\nRoute clicks from OnPlayerClickTextDraw through %s_Hit(clickedid).\n",prefix,prefix,prefix,prefix,prefix);
    if (!TDSExp_Write(file,line) || !TDSExp_Write(file,"Hit returns the original element ID, or -1 for an unrelated handle.\nFor selectable interfaces call SelectTextDraw BEFORE Show.\nPreserve existing click/cancel handlers; handle INVALID_TEXT_DRAW on ESC.\nGlobal TextDraws consume the global pool; budget other UI before integration.\n")) ok = false;
    if (!fflush(file)) ok = false;
    fclose(file);
    return ok;
}

stock TDSExp_Tick(session)
{
    if (!gTDSExportFile[session]) return 1;
    new bool:ok = true, bool:infoOwned, end = gTDSExportAt[session]+8;
    while (gTDSExportAt[session] < gTDSExportCount[session] && gTDSExportAt[session] < end)
    {
        if (!TDSExp_Element(session,gTDSExportAt[session]++)) { ok = false; break; }
    }
    if (ok && gTDSExportAt[session] < gTDSExportCount[session]) return 1;
    new path[128], instructions[128];
    format(path,sizeof(path),TDS_EXPORT_DIR "/%s.inc",gTDSExportPrefix[session]);
    format(instructions,sizeof(instructions),TDS_EXPORT_DIR "/%s.txt",gTDSExportPrefix[session]);
    if (ok) ok = TDSExp_Footer(session) && fflush(gTDSExportFile[session]);
    if (ok)
    {
        if (fexist(path) || fexist(instructions)) ok = false;
        else { infoOwned = true; ok = TDSExp_Instructions(session,instructions); }
    }
    fclose(gTDSExportFile[session]); gTDSExportFile[session] = File:0;
    if (ok) ok = !fexist(path) && frename(gTDSExportPath[session],path);
    if (!ok)
    {
        if (fexist(gTDSExportPath[session])) fremove(gTDSExportPath[session]);
        if (infoOwned && fexist(instructions)) fremove(instructions);
    }
    gTDS[session][tsBusy] = 0;
    new message[180];
    if (ok) format(message,sizeof(message),"Экспорт готов: scriptfiles/%s (CP1251). Инструкция: одноимённый .txt.",path);
    else format(message,sizeof(message),"Ошибка записи экспорта. Проверьте права на каталог scriptfiles/" TDS_EXPORT_DIR ".");
    SendClientMessage(gTDS[session][tsOwner],ok ? TDS_COLOR : ADMIN_ERROR,message);
    return TDS_Main(gTDS[session][tsOwner]);
}

stock TDS_Export(playerid)
{
    new s = TDS_RequireSession(playerid);
    if (s < 0 || gTDS[s][tsBusy] || !TDS_ProjectValid(s)) return 0;
    new slug[5], at;
    for (new i; gTDS[s][tsName][i] && at < 4; i++)
    {
        new c = tolower(gTDS[s][tsName][i]);
        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) slug[at++] = c;
    }
    if (!at) format(slug,sizeof(slug),"ui");
    fcreatedir(TDS_EXPORT_DIR); // existing directories may return false; fopen checks actual writability
    new path[128], info[128], bool:found;
    for (new attempt; attempt < 32; attempt++)
    {
        new nonce = gettime()+(++gTDSExportSerial);
        if (nonce <= 0) return 0;
        format(gTDSExportPrefix[s],24,"TD_%s_%08x",slug,nonce);
        format(gTDSExportPath[s],128,TDS_EXPORT_DIR "/%s.tmp",gTDSExportPrefix[s]);
        format(path,sizeof(path),TDS_EXPORT_DIR "/%s.inc",gTDSExportPrefix[s]);
        format(info,sizeof(info),TDS_EXPORT_DIR "/%s.txt",gTDSExportPrefix[s]);
        if (!fexist(path) && !fexist(info) && !fexist(gTDSExportPath[s])) { found = true; break; }
    }
    if (!found) return SendClientMessage(playerid,ADMIN_ERROR,"Не найдено свободное имя экспорта.");
    if (!TDS_SetMode(playerid,TDS_MENU_MODE)) return 0;
    gTDSExportFile[s] = fopen(gTDSExportPath[s],io_write);
    if (!gTDSExportFile[s]) return SendClientMessage(playerid,ADMIN_ERROR,"Не удалось создать файл экспорта. Проверьте права на каталог scriptfiles/" TDS_EXPORT_DIR ".");
    gTDSExportCount[s] = TDS_Order(s,gTDSExportSlots[s]); gTDSExportAt[s] = 0;
    if (!TDSExp_Header(s)) { TDSExp_Cancel(s); return SendClientMessage(playerid,ADMIN_ERROR,"Ошибка записи экспорта."); }
    gTDS[s][tsBusy] = -1;
    return TDS_Main(playerid);
}
