# GOV-06: separate founder-only role-assignment SQL connection.
# Copy LOCALLY as mysql-govadmin.ini in the server root next to config.json.
# NEVER commit actual credentials. Dedicated identity should have only
# EXECUTE on gov_bond_role_set (SQL SECURITY DEFINER), no table DML.
# Connection absent => /bondgovrole is unavailable, all ordinary gameplay remains.
hostname = 127.0.0.1
username = TARKENSO_GOV_ROLE_ADMIN
password = CHANGE_ME_DIFFERENT_FROM_MYSQL_INI
database = TARKENSO_DB_NAME
server_port = 3306
